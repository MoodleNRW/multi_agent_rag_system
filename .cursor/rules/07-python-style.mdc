- Verwende aussagekräftige Konstanten statt magischer Zahlen oder Zeichenketten:

```python
# Definiere Konstanten
MIN_RELEVANCE_SCORE = 0.7
MAX_RETRIEVAL_RESULTS = 5
DEFAULT_CHUNK_SIZE = 1000
DEFAULT_CHUNK_OVERLAP = 100
WEAVIATE_URL = "http://localhost:8090"

# Verwende Konstanten im Code
def retrieve_documents(query: str) -> List[Dict[str, Any]]:
    """Ruft Dokumente ab."""
    results = client.query.get(
        "Document", ["content", "metadata"]
    ).with_near_text({
        "concepts": [query]
    }).with_limit(MAX_RETRIEVAL_RESULTS).do()
    
    # Filtere nach Relevanz
    filtered_results = [
        doc for doc in results["data"]["Get"]["Document"]
        if doc.get("_additional", {}).get("score", 0) >= MIN_RELEVANCE_SCORE
    ]
    
    return filtered_results
```

- Verwende kontextmanager für Ressourcenverwaltung:

```python
from contextlib import contextmanager

@contextmanager
def weaviate_client_context():
    """Kontextmanager für Weaviate-Client."""
    client = None
    try:
        client = create_weaviate_client()
        yield client
    finally:
        if client:
            client.close()
            logger.info("Weaviate-Client geschlossen.")

# Verwendung des Kontextmanagers
def process_query(query: str) -> List[Dict[str, Any]]:
    """Verarbeitet eine Abfrage mit einem temporären Client."""
    with weaviate_client_context() as client:
        results = client.query.get(
            "Document", ["content", "metadata"]
        ).with_near_text({
            "concepts": [query]
        }).do()
        
        return results["data"]["Get"]["Document"]
```

- Verwende funktionale Programmierkonzepte, wo angemessen:

```python
from functools import reduce

def process_results(results: List[Dict[str, Any]]) -> Dict[str, Any]:
    """Verarbeitet Abfrageergebnisse funktional."""
    # Map: Transformiere jedes Ergebnis
    transformed = map(lambda doc: {
        "content": doc.get("content", ""),
        "url": doc.get("metadata", {}).get("url", ""),
        "title": doc.get("metadata", {}).get("title", "Unbekannt")
    }, results)
    
    # Filter: Entferne leere Inhalte
    filtered = filter(lambda doc: doc["content"].strip(), transformed)
    
    # Reduce: Kombiniere alle Inhalte
    combined_content = reduce(
        lambda acc, doc: f"{acc}\n\n{doc['title']}:\n{doc['content']}", 
        filtered, 
        ""
    )
    
    return {"combined_content": combined_content}
```