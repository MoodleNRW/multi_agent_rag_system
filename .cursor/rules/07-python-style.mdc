- Implementiere strukturierte Fehlerbehandlung mit try/except-Blöcken:

```python
def query_database(query):
    """Führt eine Abfrage gegen die Vektordatenbank aus."""
    try:
        # Versuche die Hauptoperation
        client = ensure_global_client()
        results = client.query.get("Document", ["content", "metadata"]).with_near_text({
            "concepts": [query]
        }).do()
        return results
    except weaviate.exceptions.WeaviateQueryError as e:
        # Behandle spezifische Abfragefehler
        logger.error(f"Fehler bei der Weaviate-Abfrage: {str(e)}")
        raise QueryError(f"Die Abfrage konnte nicht ausgeführt werden: {str(e)}")
    except weaviate.exceptions.WeaviateConnectionError as e:
        # Behandle Verbindungsfehler
        logger.error(f"Verbindungsfehler zu Weaviate: {str(e)}")
        raise ConnectionError("Keine Verbindung zur Vektordatenbank möglich")
    except Exception as e:
        # Fange alle anderen Fehler
        logger.error(f"Unerwarteter Fehler: {str(e)}", exc_info=True)
        raise
    finally:
        # Code, der immer ausgeführt wird (optional)
        pass
```

