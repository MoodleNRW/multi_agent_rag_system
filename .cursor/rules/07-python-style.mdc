# Richtig: Funktion macht nur eine Sache
def get_document_by_id(doc_id: str) -> Dict[str, Any]:
    """Holt ein Dokument anhand seiner ID."""
    client = ensure_global_client()
    result = client.data_object.get_by_id(doc_id, class_name="Document")
    return result

# Richtig: Separate Funktionen für separate Aufgaben
def validate_document(document: Dict[str, Any]) -> bool:
    """Überprüft, ob ein Dokument gültig ist."""
    return all(key in document for key in ["content", "metadata", "url"])

def process_document(document: Dict[str, Any]) -> Dict[str, Any]:
    """Verarbeitet ein Dokument."""
    if not validate_document(document):
        raise ValueError("Ungültiges Dokumentformat")
    
    # Verarbeitung...
    return processed_document
